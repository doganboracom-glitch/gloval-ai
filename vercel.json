{
  "cleanUrls": true,
  "trailingSlash": false,
  "ignoreCommand": "test \"$VERCEL_GIT_COMMIT_REF\" != \"main\"",
  "crons": [
    {
      "path": "/api/cron/domain-reconciliation",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/email-outbox",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/payment-reconcile",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/domain-transfer-relock",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/ads-purge",
      "schedule": "15 3 * * *"
    },
    {
      "path": "/api/cron/ads-publish-reconcile",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/meta-token-expiry",
      "schedule": "30 8 * * *"
    },
    {
      "path": "/api/cron/draft-reminders",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/google-ads-reports/weekly",
      "schedule": "0 12 * * 1"
    },
    {
      "path": "/api/cron/google-ads-reports/monthly",
      "schedule": "0 12 1 * *"
    }
  ]
}
