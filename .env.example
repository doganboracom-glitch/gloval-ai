# =============================================================================
# GLOVAL AI — Environment Variables (example)
# Copy to your Vercel Project settings. NEVER commit real secret values.
# Values marked (set) are already configured in this project.
# =============================================================================

# ---- Supabase (set) ---------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ---- Platform ---------------------------------------------------------------
# Absolute production origin, used to build PayTR ok/fail redirect URLs and
# canonical SEO URLs. e.g. https://gloval.site
NEXT_PUBLIC_SITE_URL=

# ---- Transactional email — Resend (set) -------------------------------------
RESEND_API_KEY=
MAIL_FROM=
ADMIN_NOTIFICATION_EMAIL=
ADMIN_EMAILS=

# ---- PayTR (REQUIRED for production payments) -------------------------------
# Obtain from your PayTR merchant panel (Mağaza Bilgileri). All three are
# secret and must only ever live in the server environment.
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
# '1' = PayTR test mode (no real charge). Set to '0' ONLY in production.
PAYTR_TEST_MODE=1

# ---- Stripe (optional; only if a store enables Stripe) ----------------------
STRIPE_WEBHOOK_SECRET=

# ---- SMS / OTP (optional; provider-agnostic phone verification) -------------
# Leave blank until a real SMS provider is chosen. API secrets are server-only.
SMS_PROVIDER=
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER=
