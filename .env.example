# =============================================================================
# GLOVAL AI — Environment Variables (example)
# Copy to your Vercel Project settings. NEVER commit real secret values.
# Values marked (set) are already configured in this project.
# =============================================================================

# ---- Supabase (set) ---------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ---- Platform ---------------------------------------------------------------
# Absolute production origin, used to build payment callback URLs and
# canonical SEO URLs. e.g. https://gloval.site
NEXT_PUBLIC_SITE_URL=

# ---- Transactional email — Resend (set) -------------------------------------
RESEND_API_KEY=
MAIL_FROM=
ADMIN_NOTIFICATION_EMAIL=
ADMIN_EMAILS=

# ---- iyzico (REQUIRED for production payments) ------------------------------
# Obtain from your iyzico merchant panel. API key and secret are server-only.
# Production must use the live host https://api.iyzipay.com; non-production
# defaults to https://sandbox-api.iyzipay.com.
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=

# ---- Stripe (optional; only if a store enables Stripe) ----------------------
STRIPE_WEBHOOK_SECRET=

# ---- SMS / OTP (optional; provider-agnostic phone verification) -------------
# Leave blank until a real SMS provider is chosen. API secrets are server-only.
SMS_PROVIDER=
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER=
